providers:
  - name: claude
    protocol: anthropic
    model: claude-sonnet-4-20250514
    base_url: https://api.anthropic.com
    api_key: replace-me
    thinking: true
    context_window_tokens: 128000

  - name: openai
    protocol: openai
    model: gpt-4o
    base_url: https://api.openai.com/v1
    api_key: replace-me
    thinking: false
    context_window_tokens: 128000

  - name: deepseek-openai
    protocol: openai
    model: deepseek-v4-flash
    base_url: https://api.deepseek.com
    api_key: replace-with-deepseek-api-key
    thinking: false
    context_window_tokens: 128000

permissions:
  mode: acceptEdits

# 可选工作树配置；省略整个区块时使用以下默认值。
# 路径必须是项目内安全相对路径，不允许 .、..、.git 或管理区域。
worktree:
  cleanup_interval_minutes: 30
  stale_cutoff_hours: 24
  symlink_directories: [] # 例如 [node_modules]；共享目标只读，默认不共享。
  required_files: [] # 例如 [.env.local]；缺失或不安全时阻止新工作树启动。

# MCP Server：通过 command/args/env 配置 stdio，或通过 url/headers 配置 Streamable HTTP。
# API key 等敏感值直接填写在配置文件中；stdio 仍需使用 Server 要求的环境变量名。
mcp_servers:
  # Context7 未配置 API key 时可使用免费额度；额度用尽后直接填写 API key。
  context7:
    command: npx
    args: ["-y", "@upstash/context7-mcp"]
    env:
      CONTEXT7_API_KEY: replace-with-context7-api-key
  github:
    command: github-mcp-server
    args: [stdio]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: replace-with-github-token
  remote:
    url: https://example.com/mcp
    headers:
      Authorization: "Bearer replace-with-mcp-token"
